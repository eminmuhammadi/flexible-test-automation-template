BROWSER_PROFILE=desktop
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADED=on
PLAYWRIGHT_TRACING=retain-on-failure
PLAYWRIGHT_VIDEO=retain-on-failure
PLAYWRIGHT_HAR=off
PLAYWRIGHT_HAR_DIR=reports/playwright/har

APPIUM_SERVER_URL=http://127.0.0.1:4723
MOBILE_APP_WAIT_ACTIVITY=com.saucelabs.mydemoapp.android.view.activities.MainActivity
MOBILE_PLATFORM=Android
MOBILE_DEVICE_NAME=Pixel_8_Pro_API_35
MOBILE_APP_PATH=https://github.com/saucelabs/my-demo-app-android/releases/download/2.3.0/mda-2.3.0-27.apk
# iOS simulator example:
# MOBILE_PLATFORM=iOS
# MOBILE_DEVICE_NAME="iPhone 16 Pro Max"
# MOBILE_UDID=<physical-device-udid-from-Xcode-Devices-and-Simulators>
# MOBILE_APP_PATH=https://github.com/saucelabs/my-demo-app-ios/releases/download/2.3.0/SauceLabs-Demo-App.ipa
